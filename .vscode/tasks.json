{
    "version": "2.0.0",

    "tasks": [
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "${workspaceFolder}\\uiBuild.bat",
            "problemMatcher": [
                "$msCompile"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}



